Ncpu = 0

[duplicatePbkp]
operation = DUPLICATE
soltab = sol000/phase000
soltabOut = phaseResid000

[ct]
operation = CLOCKTEC
soltab = sol000/phase000
numParams = 4 # clock + TEC + offset + 3rd-order TEC, for < 35 MHz
CombinePol = False
Circular = False
lofar2Mode = False 
clocksoltabOut = clock000
tecsoltabOut = tec000
offsetsoltabOut = phase_offset000
tec3rdsoltabOut = tec3rd000

[plotClock]
operation = PLOT
soltab = sol000/clock000
axesInPlot = [time]
axisInTable = ant
prefix = plots/clock
#minmax = [-2e-7,2e-7]
plotFlag = False
refAnt = SuperSt

[plotTEC]
operation = PLOT
soltab = sol000/tec000
axesInPlot = [time]
axisInTable = ant
prefix = plots/tec
minmax = [-0.5,0.5]
plotFlag = False
refAnt = SuperSt

[plotTEC3]
operation = PLOT
soltab = sol000/tec3rd000
axesInPlot = [time]
axisInTable = ant
prefix = plots/tec3rd
minmax = [-300,300]
plotFlag = False
refAnt = SuperSt

[residuals]
operation = RESIDUALS
soltab = sol000/phaseResid000
soltabsToSub = [tec000,clock000,tec3rd000]

[PlotPr1]
operation = PLOT
soltab = sol000/phaseResid000
axesInPlot = [time,freq]
axisInTable = ant
plotFlag = True
prefix = plots/phRes_
refAnt = SuperSt
minmax = [-3.14,3.14]
