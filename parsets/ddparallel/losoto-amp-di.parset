Ncpu = 0

# flag diverged solutions (e.g. at band edges next to fully flagged subbands) before they are
# smoothed, normalised and applied: a single extreme cell can otherwise propagate to NaN solutions downstream
[clipLow]
operation = CLIP
soltab = sol000/amplitude000
mode = below
clipLevel = 0.1

[clipHigh]
operation = CLIP
soltab = sol000/amplitude000
mode = above
clipLevel = 7.0

[bkp]
operation = DUPLICATE
soltab = sol000/amplitude000
soltabOut = amplitudeSmooth

[replicate]
operation = REPLICATEONAXIS
soltab = sol000/amplitudeSmooth
axisReplicate = ant
fromCell = nonflaggedCS

[norm]
operation = NORM
soltab = sol000/amplitudeSmooth
normVal = 1.
axesToNorm = [time,freq,ant]
log = True

[plotAsmooth]
operation = PLOT
soltab = sol000/amplitudeSmooth
axesInPlot = [time,freq]
axisInTable = ant
plotFlag = True
prefix = plots/ampSmooth_